<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>تذكرة طيران إلكترونية</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: "Cairo", sans-serif;
      background: #f0f4f8;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      min-height: 100vh;
      padding: 24px 16px;
    }

    /* ═══════════════════════════════════════
       CARD WRAPPER
    ═══════════════════════════════════════ */
    .ticket-card {
      width: 100%;
      max-width: 860px;
      background: #ffffff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 59, 111, 0.18),
        0 4px 16px rgba(0, 0, 0, 0.08);
    }

    /* ═══════════════════════════════════════
       HEADER
    ═══════════════════════════════════════ */
    .ticket-header {
      background: linear-gradient(135deg, #003b6f 0%, #0a5a8c 60%, #0d6fa8 100%);
      padding: 24px 28px 20px;
      position: relative;
      overflow: hidden;
    }

    /* زخرفة هندسية خفيفة */
    .ticket-header::before {
      content: "";
      position: absolute;
      top: -60px;
      left: -60px;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.04);
      pointer-events: none;
    }
    .ticket-header::after {
      content: "";
      position: absolute;
      bottom: -40px;
      right: 200px;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      background: rgba(245, 166, 35, 0.06);
      pointer-events: none;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      position: relative;
      z-index: 1;
      direction: ltr; /* Force Left-to-Right visual layout for guaranteed alignment */
    }

    /* — اليسار: اللوجو واسم المسافر (عمودي) — */
    .header-left-section {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      flex-shrink: 0;
    }

    .header-logo {
      flex-shrink: 0;
    }

    .header-logo-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

.logo-img {
  height: 180px;
  max-width: 320px;
  width: auto;
  object-fit: contain;
}

    .logo-text-fallback {
      color: #ffffff;
      font-size: 20px; /* Reduced for better proportion when image fails */
      font-weight: 900;
      letter-spacing: 1px;
    }

    .logo-text-fallback span {
      color: #f5a623;
    }

    /* — اسم المسافر (يسار، أسفل اللوجو، لون أبيض عريض) — */
    .passenger-row {
      display: flex;
      flex-direction: column;
      gap: 2px;
      direction: rtl;
      text-align: right;
    }

    .passenger-label {
      color: rgba(255, 255, 255, 0.65);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .passenger-name {
      color: #ffffff;
      font-size: 18px; /* Bold and white */
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    /* — الوسط: العناوين (في المنتصف تماماً) — */
    .header-title {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      text-align: center;
    }

    .header-title-ar {
      color: #ffffff;
      font-size: 24px; /* Larger and bold */
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .header-title-en {
      color: rgba(255, 255, 255, 0.55); /* Lighter opacity */
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
      direction: ltr;
    }

    /* — اليمين: كارت رقم التذكرة والحجز — */
    .booking-card {
      background: rgba(255, 255, 255, 0.97);
      border-radius: 16px;
      padding: 14px 18px;
      min-width: 195px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      direction: rtl;
      flex-shrink: 0;
    }

    .booking-card-row {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .booking-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .booking-item-label {
      color: #6b7280;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.5px;
    }

    .booking-item-value {
      color: #003b6f;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 1px;
      direction: ltr;
    }

    .divider-line {
      border: none;
      border-top: 1px solid #e5e7eb;
      margin: 2px 0;
    }

    /* ═══════════════════════════════════════
       FLIGHT SECTION
    ═══════════════════════════════════════ */
    .flight-section {
      padding: 24px 28px;
      background: #ffffff;
    }

    .flight-card {
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      padding: 28px 32px;
    }

    .flight-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 16px;
    }

    /* — مطار المغادرة — */
    .airport-block {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .airport-block.departure {
      text-align: right;
    }

    .airport-block.arrival {
      text-align: left;
    }

    .airport-code {
      font-size: 52px;
      font-weight: 900;
      color: #003b6f;
      line-height: 1;
      letter-spacing: -1px;
      direction: ltr;
    }

    .airport-city-ar {
      font-size: 15px;
      font-weight: 700;
      color: #1f2937;
    }

    .airport-city-en {
      font-size: 12px;
      font-weight: 400;
      color: #6b7280;
      direction: ltr;
    }

    .airport-time {
      font-size: 24px;
      font-weight: 800;
      color: #1f2937;
      margin-top: 8px;
      direction: ltr;
    }

    .airport-date {
      font-size: 12px;
      font-weight: 500;
      color: #6b7280;
      direction: ltr;
    }

    /* — خط الرحلة — */
    .route-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      position: relative;
      min-width: 160px;
    }

    .route-line-wrap {
      width: 100%;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .route-dashes {
      width: 100%;
      border: none;
      border-top: 2px dashed #c7d2e0;
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
    }

    .plane-icon {
      position: relative;
      z-index: 2;
      background: #ffffff;
      border: 2px solid #e5e7eb;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0, 59, 111, 0.12);
    }

    .plane-svg {
      width: 22px;
      height: 22px;
      fill: #003b6f;
    }

    .flight-badge {
      background: #ffffff;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 700;
      color: #003b6f;
      direction: ltr;
      white-space: nowrap;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    }

    /* ═══════════════════════════════════════
       INFO STRIP
    ═══════════════════════════════════════ */
    .info-strip {
      background: #003b6f;
      padding: 0 28px;
      margin: 0 28px 24px;
      border-radius: 16px;
      display: flex;
      align-items: stretch;
      min-height: 88px;
      overflow: hidden;
    }

    .info-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 14px 8px;
      position: relative;
    }

    .info-item:not(:last-child)::after {
      content: "";
      position: absolute;
      right: 0;
      top: 20%;
      height: 60%;
      width: 1px;
      background: rgba(255, 255, 255, 0.15);
    }

    .info-icon {
      width: 20px;
      height: 20px;
      fill: rgba(255, 255, 255, 0.7);
      margin-bottom: 2px;
    }

    .info-label {
      font-size: 10px;
      font-weight: 500;
      color: #d1d5db;
      letter-spacing: 0.3px;
      text-align: center;
    }

    .info-value {
      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
      text-align: center;
      direction: ltr;
    }

    /* ═══════════════════════════════════════
       SEPARATOR (tear line)
    ═══════════════════════════════════════ */
    .tear-line {
      display: flex;
      align-items: center;
      gap: 0;
      padding: 0 28px;
      margin-bottom: 20px;
    }

    .tear-circle {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #f0f4f8;
      flex-shrink: 0;
    }

    .tear-dots {
      flex: 1;
      border: none;
      border-top: 2px dashed #d1d5db;
    }

    /* ═══════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════ */
    .ticket-footer {
      padding: 4px 28px 28px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      direction: rtl;
    }

    /* — باركود — */
    .barcode-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .barcode-svg-wrap {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 8px 10px;
    }

    .barcode-number {
      font-size: 12px;
      font-weight: 600;
      color: #374151;
      letter-spacing: 1.5px;
      direction: ltr;
    }

    /* — تعليمات السفر — */
    .travel-notes {
      flex: 1;
      direction: rtl;
    }

    .notes-title {
      font-size: 14px;
      font-weight: 800;
      color: #f5a623;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .notes-title::before {
      content: "";
      display: inline-block;
      width: 4px;
      height: 16px;
      background: #f5a623;
      border-radius: 2px;
    }

    .notes-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .notes-list li {
      font-size: 12px;
      color: #4b5563;
      font-weight: 500;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      line-height: 1.5;
    }

    .notes-list li::before {
      content: "•";
      color: #003b6f;
      font-size: 16px;
      line-height: 1.2;
      flex-shrink: 0;
    }

    /* ═══════════════════════════════════════
       PRICE BADGE (اختياري)
    ═══════════════════════════════════════ */
    .price-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #fef3c7;
      border: 1px solid #f5a623;
      border-radius: 8px;
      padding: 4px 12px;
      margin-top: 8px;
    }

    .price-badge span {
      font-size: 13px;
      font-weight: 700;
      color: #92400e;
    }

    /* print */
    @media print {
      body {
        background: white;
        padding: 0;
      }
      .ticket-card {
        box-shadow: none;
        border-radius: 0;
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="ticket-card">

    <!-- ══════════════ HEADER ══════════════ -->
    <div class="ticket-header">
      <div class="header-inner">

        <!-- يسار: لوجو واسم المسافر (عمودي) -->
        <div class="header-left-section">
          <div class="header-logo">
            <div class="header-logo-row">
              <img src="{{logoUrl}}" alt="{{companyName}}" class="logo-img" onerror="this.style.display='none'; document.getElementById('logo-fallback').style.display='inline-block';" />
              <span id="logo-fallback" class="logo-text-fallback" style="display: none;">AL<span>BAJA</span></span>
            </div>
          </div>
          <div class="passenger-row">
            <div class="passenger-label">اسم المسافر / Passenger Name</div>
            <div class="passenger-name">{{passengerName}}</div>
          </div>
        </div>

        <!-- وسط: عنوان -->
        <div class="header-title">
          <div class="header-title-ar">تذكرة طيران إلكترونية</div>
          <div class="header-title-en">ELECTRONIC AIRLINE TICKET</div>
        </div>

        <!-- يمين: كارت التذكرة -->
        <div class="booking-card">
          <div class="booking-card-row">
            <div class="booking-item">
              <div class="booking-item-label">رقم التذكرة / Ticket No.</div>
              <div class="booking-item-value">{{ticketNumber}}</div>
            </div>
            <hr class="divider-line" />
            <div class="booking-item">
              <div class="booking-item-label">رقم الحجز / Booking Ref.</div>
              <div class="booking-item-value">{{bookingRef}}</div>
            </div>
          </div>
        </div>

      </div><!-- /header-inner -->
    </div><!-- /ticket-header -->

    <!-- ══════════════ FLIGHT SECTION ══════════════ -->
    <div class="flight-section">
      <div class="flight-card">
        <div class="flight-grid">

          <!-- المغادرة (يمين) -->
          <div class="airport-block departure">
            <div class="airport-code">{{fromCode}}</div>
            <div class="airport-city-ar">{{fromCityAr}}</div>
            <div class="airport-city-en">{{fromCityEn}}</div>
            <div class="airport-time">{{departureTime}}</div>
            <div class="airport-date">{{departureDate}}</div>
          </div>

          <!-- المسار -->
          <div class="route-center">
            <div class="route-line-wrap" style="height:44px;">
              <div class="route-dashes"></div>
              <div class="plane-icon">
                <!-- طائرة SVG -->
                <svg class="plane-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/>
                </svg>
              </div>
            </div>
            <div class="flight-badge">{{airline}} {{flightNumber}}</div>
          </div>

          <!-- الوصول (يسار) -->
          <div class="airport-block arrival">
            <div class="airport-code">{{toCode}}</div>
            <div class="airport-city-ar">{{toCityAr}}</div>
            <div class="airport-city-en">{{toCityEn}}</div>
            <div class="airport-time">{{arrivalTime}}</div>
            <div class="airport-date">{{arrivalDate}}</div>
          </div>

        </div><!-- /flight-grid -->
      </div><!-- /flight-card -->
    </div><!-- /flight-section -->

    <!-- ══════════════ INFO STRIP ══════════════ -->
    <div class="info-strip">

      <!-- درجة السفر -->
      <div class="info-item">
        <svg class="info-icon" viewBox="0 0 24 24"><path d="M20 6H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2zm-9 7H5v-2h6v2zm8 0h-2v-2h2v2zm0-4H5V8h14v1z"/></svg>
        <div class="info-label">درجة السفر</div>
        <div class="info-value">{{travelClass}}</div>
      </div>

      <!-- الأمتعة -->
      <div class="info-item">
        <svg class="info-icon" viewBox="0 0 24 24"><path d="M9 4h6V2H9v2zM4 7v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2zm8 11H8v-2h4v2zm4-6H8V9h8v3z"/></svg>
        <div class="info-label">الوزن</div>
        <div class="info-value">{{baggageAllowance}}</div>
      </div>

      <!-- شركة الطيران -->
      <div class="info-item">
        <svg class="info-icon" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>
        <div class="info-label">شركة الطيران</div>
        <div class="info-value">{{airline}}</div>
      </div>

      <!-- رقم الرحلة -->
      <div class="info-item">
        <svg class="info-icon" viewBox="0 0 24 24"><path d="M3 17h18v2H3v-2zm0-7h18v5H3v-5zm0-4h18v2H3V6z"/></svg>
        <div class="info-label">رقم الرحلة</div>
        <div class="info-value">{{flightNumber}}</div>
      </div>

      <!-- تاريخ الإصدار -->
      <div class="info-item">
        <svg class="info-icon" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
        <div class="info-label">تاريخ الإصدار</div>
        <div class="info-value">{{issueDate}}</div>
      </div>

    </div><!-- /info-strip -->

    <!-- ══════════════ TEAR LINE ══════════════ -->
    <div class="tear-line">
      <div class="tear-circle"></div>
      <hr class="tear-dots" />
      <div class="tear-circle"></div>
    </div>

    <!-- ══════════════ FOOTER ══════════════ -->
    <div class="ticket-footer">

      <!-- تعليمات السفر (يمين في RTL) -->
      <div class="travel-notes">
        <div class="notes-title">تعليمات السفر الهامة</div>
        <ul class="notes-list">
          {{#each travelNotes}}
            <li>{{this}}</li>
          {{/each}}
        </ul>

        {{#if showPrice}}
          {{#if price}}
            <div class="price-badge" style="margin-top:12px;">
              <span>{{price}} {{currency}}</span>
            </div>
          {{/if}}
        {{/if}}
      </div>

      <!-- باركود (يسار في RTL) -->
      <div class="barcode-section">
        <div class="barcode-svg-wrap">
          <svg width="240" height="64" viewBox="0 0 240 64" xmlns="http://www.w3.org/2000/svg">
            <rect width="240" height="64" fill="#ffffff" rx="8" />
            {{#each barcodeData}}
              <rect x="{{x}}" y="6" width="{{w}}" height="52" fill="#111827" />
            {{/each}}
          </svg>
        </div>
        <div class="barcode-number">{{ticketNumber}}</div>
      </div>

    </div><!-- /ticket-footer -->

  </div><!-- /ticket-card -->
</body>
</html>
