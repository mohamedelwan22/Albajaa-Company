{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
  "dev": "set NODE_ENV=development && pnpm run build && pnpm run start",
  "build": "node ./build.mjs",
  "postbuild": "node -e \"const fs=require('fs');fs.cpSync('src/lib/ticket-template','dist/lib/ticket-template',{recursive:true,force:true});fs.cpSync('src/lib/ticket-template','dist/ticket-template',{recursive:true,force:true});\"",
  "start": "node --enable-source-maps --env-file=../../.env ./dist/index.mjs",
  "typecheck": "tsc -p tsconfig.json --noEmit"
},
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.106.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "groq-sdk": "^1.2.0",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.8",
    "openai": "^6.39.0",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer": "^25.0.4",
    "sharp": "^0.34.5",
    "uuid": "^14.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
